<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_row_height"
    android:layout_marginBottom="@dimen/tv_space_s"
    android:clipChildren="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/row_main"
        style="@style/Tv.Row"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/indicator"
            android:layout_width="@dimen/tv_status_stroke"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/tv_space_m"
            android:layout_marginTop="@dimen/tv_space_s"
            android:layout_marginBottom="@dimen/tv_space_s"
            android:background="@drawable/tv_bg_indicator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:textAlignment="viewStart"
                style="@style/Tv.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_space_xs"
                android:duplicateParentState="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/type"
                    style="@style/Tv.Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/tv_space_s"
                    android:duplicateParentState="true" />

                <TextView
                    android:id="@+id/meta"
                    style="@style/Tv.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tv_space_m"
            android:duplicateParentState="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/badge_active"
                style="@style/Tv.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tv_badge_active"
                android:textColor="@color/tv_text_accent"
                android:textSize="@dimen/tv_text_caption" />

            <TextView
                android:id="@+id/latency"
                style="@style/Tv.Text.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:duplicateParentState="true"
                android:textSize="@dimen/tv_text_label" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_more"
        style="@style/Tv.RowAction"
        android:layout_marginStart="@dimen/tv_space_s"
        android:contentDescription="@string/tv_rail_manage"
        android:src="@drawable/ic_tv_more" />
</LinearLayout>
