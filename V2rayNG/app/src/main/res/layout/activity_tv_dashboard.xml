<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_safe_h"
    android:paddingTop="@dimen/tv_safe_v"
    android:paddingEnd="@dimen/tv_safe_h"
    android:paddingBottom="@dimen/tv_safe_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="@dimen/tv_icon_large"
            android:layout_height="@dimen/tv_icon_large"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            app:shapeAppearanceOverlay="@style/Tv.Circle"
            app:strokeColor="@color/tv_accent"
            app:strokeWidth="2dp" />

        <TextView
            style="@style/Tv.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tv_space_m"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/version"
            style="@style/Tv.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tv_space_m"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="11"
            android:background="@drawable/tv_bg_panel"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/tv_space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.v2ray.ang.ui.tv.TvStatusOrb
                    android:id="@+id/status_orb"
                    android:layout_width="@dimen/tv_status_badge"
                    android:layout_height="@dimen/tv_status_badge"
                    android:layout_marginStart="-12dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/tv_space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status_overline"
                        style="@style/Tv.Text.Overline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_label_status"
                        android:textAlignment="viewStart" />

                    <TextView
                        android:id="@+id/status_title"
                        android:textAlignment="viewStart"
                        style="@style/Tv.Text.Display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/status_detail"
                        android:accessibilityLiveRegion="polite"
                        android:textAlignment="viewStart"
                        style="@style/Tv.Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_connect"
                style="@style/Tv.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_space_l"
                android:nextFocusDown="@id/card_active">

                <requestFocus />
            </Button>

            <LinearLayout
                android:id="@+id/card_active"
                style="@style/Tv.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_space_m"
                android:nextFocusUp="@id/btn_connect"
                android:nextFocusDown="@id/card_active"
                android:orientation="vertical"
                android:paddingStart="@dimen/tv_space_l"
                android:paddingTop="@dimen/tv_space_m"
                android:paddingEnd="@dimen/tv_space_l"
                android:paddingBottom="@dimen/tv_space_m">

                <TextView
                    style="@style/Tv.Text.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/tv_label_active_config"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/active_name"
                    android:textAlignment="viewStart"
                    style="@style/Tv.Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_space_xs"
                    android:duplicateParentState="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/active_type"
                        style="@style/Tv.Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/tv_space_s"
                        android:duplicateParentState="true" />

                    <TextView
                        android:id="@+id/active_address"
                        style="@style/Tv.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/active_latency"
                        style="@style/Tv.Text.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:textSize="@dimen/tv_text_label" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/tv_space_l"
            android:layout_weight="9"
            android:clipChildren="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal">

                <include android:id="@+id/tile_servers" layout="@layout/item_tv_tile" />
                <Space android:layout_width="@dimen/tv_space_s" android:layout_height="0dp" />
                <include android:id="@+id/tile_subscriptions" layout="@layout/item_tv_tile" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="@dimen/tv_space_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal">

                <include android:id="@+id/tile_add" layout="@layout/item_tv_tile" />
                <Space android:layout_width="@dimen/tv_space_s" android:layout_height="0dp" />
                <include android:id="@+id/tile_test" layout="@layout/item_tv_tile" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="@dimen/tv_space_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal">

                <include android:id="@+id/tile_settings" layout="@layout/item_tv_tile" />
                <Space android:layout_width="@dimen/tv_space_s" android:layout_height="0dp" />
                <include android:id="@+id/tile_logs" layout="@layout/item_tv_tile" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
