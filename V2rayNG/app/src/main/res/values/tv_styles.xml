<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text -->
    <style name="Tv.Text" parent="">
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
        <item name="android:fontFamily">@font/manrope</item>
    </style>
    <style name="Tv.Text.Display"><item name="android:textSize">@dimen/tv_text_display</item><item name="android:fontFamily">@font/manrope_800</item><item name="android:letterSpacing">-0.02</item></style>
    <style name="Tv.Text.Title"><item name="android:textSize">@dimen/tv_text_title</item><item name="android:fontFamily">@font/manrope_800</item><item name="android:letterSpacing">-0.01</item></style>
    <style name="Tv.Text.Headline"><item name="android:textSize">@dimen/tv_text_headline</item><item name="android:fontFamily">@font/manrope_700</item></style>
    <style name="Tv.Text.Secondary"><item name="android:textColor">@color/tv_text_secondary</item></style>
    <style name="Tv.Text.Label"><item name="android:textSize">@dimen/tv_text_label</item><item name="android:textColor">@color/tv_text_secondary</item></style>
    <style name="Tv.Text.Caption"><item name="android:textSize">@dimen/tv_text_caption</item><item name="android:textColor">@color/tv_text_secondary</item></style>
    <style name="Tv.Text.Strong"><item name="android:fontFamily">@font/manrope_600</item></style>
    <style name="Tv.Text.Overline" parent="Tv.Text.Caption">
        <item name="android:textSize">@dimen/tv_text_overline</item>
        <item name="android:textColor">@color/tv_text_accent</item>
        <item name="android:fontFamily">@font/manrope_700</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Tv.Text.Chip" parent="Tv.Text.Caption">
        <item name="android:fontFamily">@font/manrope_600</item>
        <item name="android:background">@drawable/tv_bg_chip</item>
        <item name="android:paddingStart">@dimen/tv_space_s</item>
        <item name="android:paddingEnd">@dimen/tv_space_s</item>
        <item name="android:paddingTop">@dimen/tv_space_xs</item>
        <item name="android:paddingBottom">@dimen/tv_space_xs</item>
    </style>

    <style name="Tv.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Focusable controls -->
    <style name="Tv.Control" parent="">
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@animator/tv_focus_lift</item>
    </style>
    <style name="Tv.Button" parent="Tv.Control">
        <item name="android:background">@drawable/tv_bg_button</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/tv_button_height</item>
        <item name="android:paddingStart">@dimen/tv_space_l</item>
        <item name="android:paddingEnd">@dimen/tv_space_l</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
        <item name="android:fontFamily">@font/manrope_700</item>
    </style>
    <style name="Tv.Button.Primary">
        <item name="android:background">@drawable/tv_bg_button_primary</item>
        <item name="android:minHeight">@dimen/tv_button_primary_height</item>
        <item name="android:textColor">@color/tv_text_on_primary</item>
        <item name="android:textSize">@dimen/tv_text_headline</item>
    </style>
    <style name="Tv.Card" parent="Tv.Control">
        <item name="android:background">@drawable/tv_bg_card</item>
    </style>
    <style name="Tv.Row" parent="Tv.Card">
        <item name="android:stateListAnimator">@animator/tv_focus_lift_row</item>
        <item name="android:minHeight">@dimen/tv_row_height</item>
        <item name="android:paddingStart">@dimen/tv_space_l</item>
        <item name="android:paddingEnd">@dimen/tv_space_l</item>
        <item name="android:paddingTop">@dimen/tv_space_s</item>
        <item name="android:paddingBottom">@dimen/tv_space_s</item>
    </style>
    <style name="Tv.RowAction" parent="Tv.Control">
        <item name="android:background">@drawable/tv_bg_card</item>
        <item name="android:padding">@dimen/tv_space_m</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/tv_icon_tint</item>
        <item name="android:layout_width">@dimen/tv_row_height</item>
        <item name="android:layout_height">match_parent</item>
    </style>
    <style name="Tv.RailItem" parent="Tv.Control">
        <item name="android:fontFamily">@font/manrope_600</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/tv_bg_rail</item>
        <item name="android:drawablePadding">@dimen/tv_space_m</item>
        <item name="android:drawableTint">@color/tv_icon_tint</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:minHeight">@dimen/tv_button_height</item>
        <item name="android:paddingStart">@dimen/tv_space_m</item>
        <item name="android:paddingEnd">@dimen/tv_space_m</item>
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:textSize">@dimen/tv_text_label</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/tv_space_xs</item>
    </style>

    <!-- Framework-built screens and dialogs -->
    <style name="Tv.ListItemText" parent="">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
        <item name="android:textColor">@color/tv_text_primary_raw</item>
    </style>
    <style name="Tv.ListItemText.Secondary">
        <item name="android:textSize">@dimen/tv_text_caption</item>
        <item name="android:textColor">@color/tv_text_secondary_raw</item>
    </style>
    <style name="Tv.DialogTitle" parent="@style/RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/Tv.DialogTitleText</item>
        <item name="android:fontFamily">@font/manrope_800</item>
    </style>
    <style name="Tv.DialogTitleText" parent="">
        <item name="android:fontFamily">@font/manrope_800</item>
        <item name="android:textSize">@dimen/tv_text_headline</item>
        <item name="android:textColor">@color/tv_text_primary_raw</item>
    </style>
    <style name="Tv.DialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/tv_bg_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:textSize">@dimen/tv_text_label</item>
        <item name="android:minHeight">@dimen/tv_button_height</item>
        <item name="android:minWidth">@dimen/tv_row_height</item>
        <item name="android:paddingStart">@dimen/tv_space_l</item>
        <item name="android:paddingEnd">@dimen/tv_space_l</item>
        <item name="android:layout_marginStart">@dimen/tv_space_s</item>
    </style>
    <style name="Tv.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/tv_bg_field</item>
        <item name="android:minHeight">@dimen/tv_button_height</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
        <item name="android:textColor">@color/tv_text_primary_raw</item>
        <item name="android:textColorHint">@color/tv_status_off</item>
    </style>
    <style name="Tv.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/tv_bg_field</item>
        <item name="android:minHeight">@dimen/tv_button_height</item>
    </style>
    <style name="Tv.Button.Form" parent="Tv.DialogButton" />
    <style name="Tv.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@android:color/transparent</item>
        <item name="titleTextStyle">@style/Tv.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Tv.ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">@dimen/tv_text_title</item>
        <item name="android:textColor">@color/tv_text_primary_raw</item>
        <item name="android:fontFamily">@font/manrope_800</item>
    </style>
    <style name="Tv.ScreenAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/tv_screen_in</item>
        <item name="android:activityOpenExitAnimation">@anim/tv_screen_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/tv_screen_in</item>
        <item name="android:activityCloseExitAnimation">@anim/tv_screen_out</item>
    </style>
    <style name="Tv.DialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="viewInflaterClass">com.v2ray.ang.util.SafeAppCompatViewInflater</item>
        <item name="android:windowBackground">@drawable/tv_bg_dialog</item>
        <item name="android:windowMinWidthMajor">@dimen/tv_dialog_width</item>
        <item name="android:windowMinWidthMinor">@dimen/tv_dialog_width</item>
        <item name="android:windowTitleStyle">@style/Tv.DialogTitle</item>
        <item name="colorAccent">@color/tv_accent</item>
        <item name="android:textColorPrimary">@color/tv_text_primary_raw</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary_raw</item>
        <item name="android:textAppearanceMedium">@style/Tv.ListItemText</item>
        <item name="textAppearanceListItemSmall">@style/Tv.ListItemText</item>
        <item name="android:textAppearanceListItemSmall">@style/Tv.ListItemText</item>
        <item name="listPreferredItemHeightSmall">@dimen/tv_button_height</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/tv_button_height</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/tv_bg_list_item</item>
        <item name="listChoiceBackgroundIndicator">@drawable/tv_bg_list_item</item>
        <item name="buttonBarButtonStyle">@style/Tv.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Tv.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Tv.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Tv.DialogButton</item>
        <item name="editTextStyle">@style/Tv.EditText</item>
        <item name="android:editTextStyle">@style/Tv.EditText</item>
        <item name="spinnerStyle">@style/Tv.Spinner</item>
        <item name="android:spinnerStyle">@style/Tv.Spinner</item>
    </style>
</resources>
