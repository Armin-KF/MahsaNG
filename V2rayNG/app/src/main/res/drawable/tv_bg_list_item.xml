<?xml version="1.0" encoding="utf-8"?>
<!-- Framework-built rows (preferences, dialog lists) cannot invert their text, so focus is a ring here. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="@integer/tv_anim_focus" android:exitFadeDuration="@integer/tv_anim_focus">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/tv_surface_2" />
            <stroke android:width="@dimen/tv_status_stroke" android:color="@color/tv_focus_fill" />
            <corners android:radius="@dimen/tv_radius_s" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/tv_surface_2" /><corners android:radius="@dimen/tv_radius_s" /></shape>
    </item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
